# URL base da API FastAPI
# Desenvolvimento: http://127.0.0.1:8000/api/v1
# (evite "localhost" no Windows: pode resolver para IPv6 e não alcançar o Docker)
# Produção: https://api.seudominio.com/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Usuário demo do seed (Ana Souza)
VITE_USER_ID=a54a52c3-8543-56d3-8e4b-6d8220667bd5

# Localização padrão (Osasco/SP) quando a geolocalização não está disponível
VITE_DEFAULT_LAT=-23.5325
VITE_DEFAULT_LON=-46.7939
VITE_DEFAULT_LOCATION=Osasco, SP

# Grupo do experimento A/B de recomendações
# Só é usado no modo 'demo'. No modo 'experiment' o backend atribui e persiste
# o grupo por hash do usuário, e esta variável é ignorada.
# Valores: '' (baseline), 'personalized' (ML) ou 'distance' (por distância)
VITE_AB_GROUP=

# Modo das recomendações: 'experiment' (padrão, conta nas métricas oficiais)
# ou 'demo' (seleção manual; eventos marcados como demo e excluídos das
# métricas oficiais).
VITE_EXPERIMENT_MODE=experiment

# A descoberta de restaurantes usa OpenStreetMap/Overpass no backend, que não
# exige chave nas instâncias públicas. O frontend apenas consome a API do
# FoodFlow e renderiza o mapa Leaflet com tiles do OpenStreetMap.
