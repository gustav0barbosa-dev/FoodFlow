# URL base da API FastAPI
# Desenvolvimento: http://localhost:8000/api/v1
# Produção: https://api.seudominio.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Usuário demo do seed (Ana Souza)
VITE_USER_ID=a54a52c3-8543-56d3-8e4b-6d8220667bd5

# Localização padrão (Osasco/SP) quando a geolocalização não está disponível
VITE_DEFAULT_LAT=-23.5325
VITE_DEFAULT_LON=-46.7939
VITE_DEFAULT_LOCATION=Osasco, SP

# Grupo do experimento A/B de recomendações
# Valores: '' (padrão do backend), 'personalized' (ML) ou 'distance' (por distância)
VITE_AB_GROUP=
