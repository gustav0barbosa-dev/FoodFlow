# Variáveis de ambiente do backend FoodFlow
# Copie para .env e ajuste conforme seu ambiente.

# Banco de dados (PostgreSQL + PostGIS)
DATABASE_URL=postgresql+asyncpg://foodflow:foodflow@localhost:5432/foodflow

# Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# Origens permitidas pelo CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenStreetMap via Overpass API — descoberta de restaurantes reais.
# Não é necessária chave para as instâncias públicas. Use uma instância
# própria ou provedor especializado em produção com tráfego elevado.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Tempo de cache dos resultados no Redis (segundos).
OVERPASS_CACHE_TTL_SECONDS=300
# Timeout da consulta Overpass (segundos).
OVERPASS_TIMEOUT_SECONDS=25
# User-Agent identificável exigido pelas instâncias públicas.
OVERPASS_USER_AGENT=FoodFlow/0.2

# LoRA (experimental): carrega o re-ranker apenas quando true.
# Requer requirements-llmops.txt e um adapter treinado em models/lora_reranker/.
ENABLE_LORA_RERANKER=false

# Experimento A/B: versão explícita e limites mínimos configuráveis.
# A versão entra no hash de atribuição e no contexto dos eventos.
EXPERIMENT_VERSION=2026-11-v1
EXPERIMENT_MIN_IMPRESSIONS=30
EXPERIMENT_MIN_USERS_PER_GROUP=5
EXPERIMENT_MIN_CLICKS_PER_GROUP=5
EXPERIMENT_MIN_PURCHASES_PER_GROUP=1
# Limiares mais rígidos para liberar testes estatísticos (não para "vencer").
EXPERIMENT_STATISTICAL_MIN_IMPRESSIONS=100
EXPERIMENT_STATISTICAL_MIN_USERS_PER_GROUP=20
EXPERIMENT_STATISTICAL_ALPHA=0.05

# Google Street View (opcional). A chave fica SOMENTE no backend e nunca é
# enviada ao navegador: o frontend consulta /street-view/metadata e carrega a
# imagem pelo proxy /street-view/image. Sem chave, o componente fica oculto.
GOOGLE_MAPS_API_KEY=
STREET_VIEW_TIMEOUT_SECONDS=5
STREET_VIEW_RADIUS_METERS=50

# Exemplo de produção:
# DATABASE_URL=postgresql+asyncpg://foodflow:foodflow@postgres:5432/foodflow
# REDIS_URL=redis://redis:6379/0
# CORS_ORIGINS=https://app.seudominio.com,https://www.seudominio.com
