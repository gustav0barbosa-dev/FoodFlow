{
  "name": "foodflow-api",
  "private": true,
  "version": "0.2.0",
  "description": "FoodFlow Backend API (FastAPI + PostGIS + Redis)",
  "scripts": {
    "dev": "uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "init-db": "python scripts/init_db.py",
    "migrate": "python -m alembic upgrade head",
    "batch-score": "python scripts/batch_score.py",
    "drift-detect": "python scripts/drift_detect.py",
    "train-lora": "python scripts/train_lora.py",
    "publish-lora": "python scripts/publish_lora.py",
    "build": "python -m compileall -q app scripts",
    "test": "python -m pytest"
  },
  "dependencies": {}
}
